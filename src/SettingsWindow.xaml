<Window x:Class="LiveBackground.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiveBackground settings" Width="760" Height="720"
        MinWidth="760" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#1F2329" Foreground="#E6EAF0"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#1F2329"/>
        <SolidColorBrush x:Key="Surface" Color="#262B33"/>
        <SolidColorBrush x:Key="Surface2" Color="#2D333D"/>
        <SolidColorBrush x:Key="Border" Color="#3A424E"/>
        <SolidColorBrush x:Key="Text" Color="#E6EAF0"/>
        <SolidColorBrush x:Key="Muted" Color="#A7B0BC"/>
        <SolidColorBrush x:Key="Accent" Color="#5B6675"/>
        <SolidColorBrush x:Key="AccentStrong" Color="#7A8798"/>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource Bg}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#9AA6B2"/>
                                <Setter Property="TextElement.Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#222831"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#222831"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
            <TextBlock Text="Wallpaper mode:" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource Muted}"/>
            <Border x:Name="ModePill" CornerRadius="13" Background="#2A3038" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="ModeVideoBtn" Content="Video" Width="78" Height="26" Margin="0" Click="ModeVideoBtn_Click"/>
                    <ToggleButton x:Name="ModeImagesBtn" Content="Images" Width="78" Height="26" Margin="4,0,0,0" Click="ModeImagesBtn_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <TabControl x:Name="MainTabs" Grid.Row="1">
            <TabItem x:Name="TabVideos" Header="Videos"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="VideosPanel" Margin="12"/></ScrollViewer></TabItem>
            <TabItem x:Name="TabPlayback" Header="Playback"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PlaybackPanel" Margin="12"/></ScrollViewer></TabItem>
            <TabItem x:Name="TabImages" Header="Images"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ImagesPanel" Margin="12"/></ScrollViewer></TabItem>
            <TabItem x:Name="TabSlideshow" Header="Slideshow"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SlideshowPanel" Margin="12"/></ScrollViewer></TabItem>
            <TabItem x:Name="TabMultiMonitor" Header="Multi Monitor"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="MultiMonitorPanel" Margin="12"/></ScrollViewer></TabItem>
            <TabItem x:Name="TabOther" Header="Other"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="OtherPanel" Margin="12"/></ScrollViewer></TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Content="Save and apply" MinWidth="130" Margin="0,0,8,0" Click="SaveButton_Click" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="100" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
