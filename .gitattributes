# Line endings.
#
# Every text file is stored with LF and checked out with LF, so the sources are
# byte-identical on every machine. Without this, core.autocrlf=true rewrites the
# working tree to CRLF and git prints "LF will be replaced by CRLF" on every
# commit.
* text=auto eol=lf

# Binary files are never converted or diffed.
*.exe   binary
*.dll   binary
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.cer   binary
*.pfx   binary
*.mp4   binary
*.zip   binary
*.7z    binary
